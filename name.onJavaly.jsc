do==end=true*10;

class of Java {class public; import new {System, Scanner};}
class of Main extends Java {
  class public;
  class switch Java;
  System.out.println("Hello, World!");
  class switch Main;
}

class of Main extends Main Java {
  class public;
  class switch Java;
  new switch Scanner;
  void Command super = function (dafunc) {
    dafunc.push(["then"]).then(trigger -> {
      void::return || void.clearConsole();
      trigger::return
    };
  }
}
asCommand do // putting a semicolon in an end command will throw SemiError
